{
  "manifest_version": 3,
  "name": "DeepSeek Kit",
  "version": "0.16.2",
  "minimum_chrome_version": "105",
  "description": "A small, local-only helper for chat.deepseek.com: prompts, memory notes and snippets, code block tools, and inline charts.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "lib.js",
        "site.js",
        "visuals.js",
        "markdown.js",
        "ask.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
